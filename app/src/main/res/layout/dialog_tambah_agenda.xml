<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tambah Agenda Kajian"
        android:textColor="#0F4C3A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_judul_agenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Judul Kajian / Acara"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_pembicara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Pembicara / Penceramah"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_tanggal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Tanggal (misal: Sabtu, 10 Okt)"
        android:inputType="text" />

    <EditText
        android:id="@+id/et_waktu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Waktu (misal: Ba'da Maghrib)"
        android:inputType="text" />

</LinearLayout>