<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <!-- Header Hijau -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F4C3A"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_title_agenda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Agenda &amp; Kajian"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/et_search_agenda"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search_input"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="12dp"
            android:hint="Cari kajian atau agenda..."
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#A3D9C9"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Horizontal Scroll Bar Kategori (Filter Chip) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_filter_semua"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#0F4C3A"
                android:text="Semua"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="20dp" />

            <Button
                android:id="@+id/btn_filter_kajian"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="Kajian"
                android:textAllCaps="false"
                android:textColor="#424242"
                app:cornerRadius="20dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btn_filter_rapat"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FFFFFF"
                android:text="Rapat"
                android:textAllCaps="false"
                android:textColor="#424242"
                app:cornerRadius="20dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btn_filter_event"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#FFFFFF"
                android:text="Event"
                android:textAllCaps="false"
                android:textColor="#424242"
                app:cornerRadius="20dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Container RecyclerView & FAB Tambah -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_agenda_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="80dp" />

        <!-- Floating Action Button Tambah Agenda -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_tambah_agenda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="90dp"
            android:contentDescription="Tambah Agenda"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="#0F4C3A"
            app:tint="#FFFFFF" />
    </RelativeLayout>

</LinearLayout>